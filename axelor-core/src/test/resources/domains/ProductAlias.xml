<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <module name="test" package="com.axelor.test.db"/>

  <!--
    Owning side to Product that shares the field name "product" with ProductConfig.product.
    Product declares mappedBy="product" only for ProductConfig, testing type-aware
    inverse lookup.
  -->
  <entity name="ProductAlias" table="TEST_PRODUCT_ALIAS">

    <one-to-one name="product" ref="Product"/>

  </entity>

</domain-models>
